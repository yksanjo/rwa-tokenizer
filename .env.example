# === REQUIRED ===
# Your private key (never commit this!)
PRIVATE_KEY=0x...

# DeepSeek API key for AI-powered code generation
DEEPSEEK_API_KEY=sk-...

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=...

# === OPTIONAL (defaults work for local dev) ===
# RPC URL (defaults to public Sepolia)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/...

# WalletConnect Project ID (for frontend)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=...

# === NETWORK CONFIG ===
# Supported chains
ETH_MAINNET_RPC=https://eth-mainnet.g.alchemy.com/v2/...
POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/...
ARBITRUM_RPC=https://arb-mainnet.g.alchemy.com/v2/...
OPTIMISM_RPC=https://opt-mainnet.g.alchemy.com/v2/...
